    {
      "parameters": {
        "jsCode": "// El unico lugar donde hace falta codigo, y se ve por que:\n// el nodo HTML devuelve TRES listas paralelas (los enlaces, los titulos,\n// las fechas) y nosotros necesitamos UNA norma por fila. Cruzar listas por\n// posicion no es algo que ningun nodo sepa hacer.\n//\n// De paso pasamos la fecha de \"08-jul-2024\" a \"2024-07-08\", que es la unica\n// forma de poder compararla despues.\n\nconst MESES = { ene: '01', feb: '02', mar: '03', abr: '04', may: '05', jun: '06',\n                jul: '07', ago: '08', sep: '09', oct: '10', nov: '11', dic: '12' };\n\nfunction aIso(fecha) {\n  const partes = String(fecha || '').trim().split('-');\n  if (partes.length !== 3 || !MESES[partes[1]]) return fecha || '';\n  return partes[2] + '-' + MESES[partes[1]] + '-' + partes[0].padStart(2, '0');\n}\n\nconst lista = (v) => (Array.isArray(v) ? v : v ? [v] : []);\n\nconst salida = [];\n\nfor (const item of $input.all()) {\n  const enlaces = lista(item.json.enlaces);\n  const etiquetas = lista(item.json.etiquetas);\n  const titulos = lista(item.json.titulos);\n  const fechas = lista(item.json.fechas);\n\n  // Si no hubo resultados devolvemos igual UN item con cantidad 0.\n  // Si devolvieramos cero items, el Switch que sigue no se ejecutaria nunca\n  // y el bot se quedaria callado: un nodo que no recibe items no corre.\n  if (enlaces.length === 0) {\n    salida.push({ json: { cantidad: 0 } });\n    continue;\n  }\n\n  for (let i = 0; i < enlaces.length; i++) {\n    const id = (String(enlaces[i]).match(/id=(\\d+)/) || [])[1] || '';\n    salida.push({\n      json: {\n        cantidad: enlaces.length,\n        id: id,\n        etiqueta: String(etiquetas[i] || '').replace(/\\s+/g, ' ').trim(),\n        titulo: String(titulos[i] || '').replace(/\\s+/g, ' ').trim(),\n        publicacion: aIso(fechas[i]),\n        url_ficha: 'https://servicios.infoleg.gob.ar/infolegInternet/verNorma.do?id=' + id\n      }\n    });\n  }\n}\n\nreturn salida;"
      },
