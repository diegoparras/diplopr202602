      "id": "c5000001-0090-4090-8a90-000000000090",
      "name": "Cita genérica"
    },
    {
      "parameters": {
        "jsCode": "// El único lugar de la clase donde hace falta código, y se ve por qué:\n// InfoLeg guarda el texto de cada norma adentro de una carpeta que agrupa\n// de a cinco mil ids. La 27.742 tiene id 401266, así que su carpeta es\n// 400000-404999. Eso no es un dato que venga en la respuesta: es una cuenta.\n\nconst salida = [];\n\nfor (const item of $input.all()) {\n  const id = Number(item.json.id_infoleg);\n  const desde = Math.floor(id / 5000) * 5000;\n  const hasta = desde + 4999;\n\n  salida.push({\n    json: {\n      ...item.json,\n      carpeta: `${desde}-${hasta}`,\n      url_ficha: `https://servicios.infoleg.gob.ar/infolegInternet/verNorma.do?id=${id}`,\n      url_texto: `https://servicios.infoleg.gob.ar/infolegInternet/anexos/${desde}-${hasta}/${id}/norma.htm`\n    }\n  });\n}\n\nreturn salida;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [800, 240],
      "id": "c5000001-0100-4100-8a00-000000000100",
      "name": "Calcular la carpeta"
    },
