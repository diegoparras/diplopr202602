      ],
      "name": "Es una factura: sigue la clase 9",
      "id": "c10a0000-0000-4000-8000-000000000006"
    },
    {
      "parameters": {
        "inputText": "={{ 'De: ' + $json.from + '\\nAsunto: ' + $json.subject + '\\n\\n' + ($json.text || $json.snippet || '') }}",
        "categories": {
          "categories": [
            {
              "category": "consulta de pago",
              "description": "El remitente pregunta si una factura ya se pago, cuando se va a pagar o en que estado esta."
