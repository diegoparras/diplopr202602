      "id": "c10a0000-0000-4000-8000-000000000011"
    },
    {
      "parameters": {
        "chatId": "PEGAR_CHAT_ID_DE_MARCELA",
        "text": "={{ $json.estado\n  ? 'Consulta por un pago de ' + $('Sacar el número').item.json.from + '\\n\\nLa factura ' + $json.numero + ' esta: ' + $json.estado + '.\\n\\nBorrador:\\nHola, la factura ' + $json.numero + ' esta recibida y ' + ($json.estado === 'para pagar' ? 'en cola para pagar' : 'pendiente de autorizacion') + '. Saludos.'\n  : 'Consulta por un pago de ' + $('Sacar el número').item.json.from + ', pero no pude identificar la factura' + ($('Sacar el número').item.json.numero ? ' (' + $('Sacar el número').item.json.numero + ' no esta en la tabla)' : ' (no trae numero)') + '. Contestale vos.\\n\\nAsunto: ' + $('Sacar el número').item.json.subject }}",
        "additionalFields": {
