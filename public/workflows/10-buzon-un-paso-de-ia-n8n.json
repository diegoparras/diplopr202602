        }
      },
      "id": "c10a0000-0000-4000-8000-000000000008"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c10a0000-0000-4000-8000-000000000009",
              "name": "numero",
              "value": "={{ (($json.subject + ' ' + ($json.text || $json.snippet || '')).match(/[A-Z]?-?\\d{1,4}-\\d{4,8}/) || [''])[0].replace(/[^0-9-]/g, '').split('-').filter(p => p).map(p => Number(p)).join('-') }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
