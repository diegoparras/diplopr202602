            {
              "id": "c10a0000-0000-4000-8000-000000000004",
              "leftValue": "={{ $json.attachments ? $json.attachments.length : 0 }}",
              "rightValue": "=0",
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -20,
        300
      ],
      "name": "¿Trae adjunto?",
      "id": "c10a0000-0000-4000-8000-000000000005"
    },
    {
      "parameters": {},
